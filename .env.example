# Copia este archivo a .env y ajusta los valores.

# Cadena de conexión que usa la app / la CLI de Prisma.
# - Desde el host (desarrollo local): host = localhost
# - Dentro de docker-compose: host = db  (lo inyecta docker-compose.yml)
DATABASE_URL="postgresql://jpqc:jpqc_dev_pw@localhost:5432/jpqc?schema=public"

# Credenciales de PostgreSQL para el servicio 'db' de docker-compose.
POSTGRES_USER="jpqc"
POSTGRES_PASSWORD="jpqc_dev_pw"
POSTGRES_DB="jpqc"
