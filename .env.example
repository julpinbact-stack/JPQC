# Copia este archivo a .env y ajusta los valores.

# Cadena de conexión que usa la app / la CLI de Prisma.
# - Desde el host (desarrollo local): host = localhost
# - Dentro de docker-compose: host = db  (lo inyecta docker-compose.yml)
DATABASE_URL="postgresql://jpqc:jpqc_dev_pw@localhost:5432/jpqc?schema=public"

# Credenciales de PostgreSQL para el servicio 'db' de docker-compose.
POSTGRES_USER="jpqc"
POSTGRES_PASSWORD="jpqc_dev_pw"
POSTGRES_DB="jpqc"

# ── Modo demostración ────────────────────────────────────────────────────────
# "true": instancia pública con datos ficticios y SIN login (muestra la franja
# de aviso). Cualquier otro valor / sin definir: instancia real, con login.
DEMO_MODE="false"

# ── Autenticación (solo cuando DEMO_MODE != "true") ──────────────────────────
# Correo autorizado para iniciar sesión.
AUTH_EMAIL="usuario@ejemplo.com"
# Hash bcrypt de la contraseña (NUNCA la contraseña en texto plano).
# Generar con: node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE',12))"
AUTH_PASSWORD_HASH="$2b$12$reemplazar_por_el_hash_generado"
# Secreto para firmar la sesión (mín. 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="reemplazar_por_un_secreto_largo_y_aleatorio"
